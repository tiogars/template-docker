# Copy the values into the Dokploy "Environment" tab (or into .env for a local test).
POSTGRES_DB=template
POSTGRES_USER=template
POSTGRES_PASSWORD=change-me
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
# At least 32 characters, e.g. openssl rand -base64 48
APP_JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-characters
APP_JWT_EXPIRATION_SECONDS=3600
# Public URLs assigned in Dokploy > Domains
API_BASE_URL=https://api.example.com
APP_CORS_ALLOWED_ORIGINS=https://console.example.com
DOCS_BASE_URL=https://tiogars.github.io/template-docs-mkdocs/
GITHUB_BASE_URL=https://github.com/tiogars/template-react-backend
# Image tags (latest, sha-<commit>, or v<version>)
API_IMAGE_TAG=latest
BACKEND_IMAGE_TAG=latest
